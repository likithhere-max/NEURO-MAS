# Copy to backend/.env for local runs. On a host (Render etc.) enter these as environment variables instead.
# NEVER commit real values.  .env is git-ignored.

ENVIRONMENT=production                 # development = local only (allows open clinician signup and AUTO_CONFIRM_EMAIL)

# Supabase (Project Settings -> API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Google Gemini (AI Studio)
GEMINI_API_KEY=...

# Clinician signup in production needs this code (choose any long random string; share it only with clinician users)
CLINICIAN_INVITE_CODE=change-me-to-a-long-random-string

# JSON list. Put your exact Netlify URL (no trailing slash). Add localhost for local testing.
CORS_ORIGINS=["https://YOUR-SITE.netlify.app","http://localhost:3000"]

# Render/Railway/Fly put one proxy in front of the app. Leave 0 if unsure (rate limiting then keys on the proxy IP).
TRUSTED_PROXY_COUNT=1
